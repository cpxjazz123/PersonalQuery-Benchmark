# PersonalQuery environment variables (sample / template)
#
# All variables below have a hard-coded default that matches the original
# in-tree absolute paths, so the pipeline runs without any of these set.
# Copy this file to `env.local` (kept out of git) and `source env.local` in
# your shell if you need to redirect any path to a different location
# (e.g. a different scratch volume, a different venv, or a relocated data
# directory on a shared cluster).
#
#   cp env.example env.local
#   source env.local
#
# Then run any stage script as usual. The Python code reads these via
# `os.environ.get(...)` with the same defaults.

# ----------------------------------------------------------------------
# Required paths
# ----------------------------------------------------------------------

# Repo root — parent directory of the stage subdirectories
# Default: /home/wlia0047/ar57/wenyu/PersonalQuery
# Used for: in-repo absolute paths that the stage scripts read
# Override only if you cloned the repo to a different location.
# export PQ_REPO_ROOT=/home/wlia0047/ar57/wenyu/PersonalQuery

# Raw Amazon-2023 review/meta data directory (read-only)
# Default: /home/wlia0047/hj82/wenyu/PersonalQuery/data
# Stages 01/02/05/06/07/08/10/11/12/13/14 read meta + review JSONL files from here.
# export PQ_DATA_DIR=/home/wlia0047/hj82/wenyu/PersonalQuery/data

# Scratch / working directory — written by every stage for cache, intermediate
# artifacts, embedding caches, log files. Recommend a large-volume filesystem.
# Default: /home/wlia0047/hj82_scratch2/wenyu
# export PQ_SCRATCH=/home/wlia0047/hj82_scratch2/wenyu

# HuggingFace cache — model weights for sentence-transformers, GECToR, vLLM
# Default: /home/wlia0047/hj82/wenyu/hf_cache
# export PQ_HF_CACHE=/home/wlia0047/hj82/wenyu/hf_cache

# Project Python interpreter (the pq_env venv required by Rule 7 of AGENTS.md)
# Default: /home/wlia0047/ar57_scratch/wenyu/pq_env/bin/python
# Used by Stage 04b (trainable Gaussian) and Stage 09 (GECToR subprocess)
# when launching nohup subprocesses.
# export PQ_PYTHON=/home/wlia0047/ar57_scratch/wenyu/pq_env/bin/python

# ----------------------------------------------------------------------
# Quick start
# ----------------------------------------------------------------------
#
# The pipeline is runnable as-is with the defaults above; nothing here is
# mandatory. Only set variables you actually need to override.
#
# Example: redirect scratch to a different volume
#
#     export PQ_SCRATCH=/scratch/$USER/personalquery
#     python 04_gaussian/fit_per_user_gaussian.py
#
# Example: use a different venv
#
#     export PQ_PYTHON=/opt/conda/envs/myenv/bin/python
#     python 09_sercl_user_profile/sercl_user_profile.py
#
# ----------------------------------------------------------------------
# Path-resolution contract (do not change without coordinating with all
# stage scripts)
# ----------------------------------------------------------------------
#
# Python code resolves each variable exactly once at module import time
# using `os.environ.get(NAME, DEFAULT)`. After import the constant is
# fixed for the lifetime of the process; restarting the script picks up
# any new env-var values.
#
# The constants appear in each stage under canonical names:
#
#   REPO_ROOT     = Path(__file__).resolve().parent.parent    # always relative to script
#   SCRATCH       = Path(os.environ.get("PQ_SCRATCH",   "<default>"))
#   DATA_DIR      = Path(os.environ.get("PQ_DATA_DIR",  "<default>"))
#   HF_CACHE_DIR  = os.environ.get("PQ_HF_CACHE", "<default>")
#   PQ_PYTHON     = os.environ.get("PQ_PYTHON", "<default>")
#
# Stage 09 launches the GECToR subprocess via:
#
#   nohup $PQ_PYTHON $PQ_REPO_ROOT/09_sercl_user_profile/gector_subprocess.py &
#
# (in the parent shell context, not Python; see the Stage 09 module
# docstring for the exact invocation).